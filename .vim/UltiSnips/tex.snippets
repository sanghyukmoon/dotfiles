# Personal TeX snippets layered over vim-snippets/UltiSnips/tex.snippets.
# These math-font triggers come from the legacy snippets/tex.snippets file,
# expressed in native UltiSnips syntax. Personal definitions win over bundled
# definitions while upstream snippet submodules remain clean and updateable.
priority 100

snippet mr "mathrm (in-word)" i
\mathrm{${1:${VISUAL:text}}}${0}
endsnippet

snippet mb "mathbf (in-word)" i
\mathbf{${1:${VISUAL:text}}}${0}
endsnippet

snippet mf "mathfrak" w
\mathfrak{${1:${VISUAL:text}}}${0}
endsnippet

snippet mc "mathcal" w
\mathcal{${1:${VISUAL:text}}}${0}
endsnippet

snippet ms "mathscr" w
\mathscr{${1:${VISUAL:text}}}${0}
endsnippet

# Delimiter pairs: Ctrl-J moves from the contents to after the closing mark.
snippet lr "left/right delimiters" w
\left${1:(} ${2:${VISUAL}} \right$1$0
endsnippet

snippet lr( "left/right parentheses" w
\left( ${1:${VISUAL}} \right)$0
endsnippet

snippet lr| "left/right vertical bars" w
\left| ${1:${VISUAL}} \right|$0
endsnippet

snippet lr{ "left/right braces" w
\left\{ ${1:${VISUAL}} \right\}$0
endsnippet

snippet lr[ "left/right brackets" w
\left[ ${1:${VISUAL}} \right]$0
endsnippet

snippet lra "angle brackets" w
\langle ${1:${VISUAL}} \rangle$0
endsnippet

snippet rv "right vertical" w
\rvert
endsnippet
